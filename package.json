{
  "name": "ciproof",
  "version": "0.0.0",
  "description": "Behavioral verification for GitHub Actions. Write what your CI must guarantee, get a concrete counterexample when it doesn't.",
  "license": "MIT",
  "author": "Abishek Giri",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ciproof": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
